@inject ConfigState ConfigState
@inject ConfigStorage ConfigStorage
@inject NavigationManager NavigationManager
@inject TraderDirectory TraderDirectory

@if (Draft is null)
{
    <div class="moar-database__empty"><strong>No medical pack selected</strong><p>Create a medical pack, or choose one from the <a href="/moar-supplies/database">database</a>.</p></div>
}
else
{
    <div class="moar-modify__layout">
        <form class="moar-editor" @onsubmit:preventDefault>
            <section class="moar-editor__section">
                <div class="moar-editor__section-heading"><p class="moar-kicker">BASE MEDICAL ITEM</p><h2>Start with a vanilla medical item</h2><p>The base retains its native treatment behavior, animations, and client assets. Pool behavior: med kits use this as their total HP resource; surgical kits consume one point per surgery; other medical items retain their native resource behavior.</p></div>
                <div class="moar-form-grid">
                    <label>Base medical item<select value="@Draft.BaseItem" @onchange="SelectBaseItem">@foreach (string item in BaseItems) { <option value="@item">@DisplayName(item)</option> }</select></label>
                    <label>@ResourceLabel<input type="number" min="0" @bind="Draft.Resource" /></label>
                    @if (IsMedicalKit)
                    {
                        <label>Health per treatment<input type="number" min="0" step="any" @bind="Draft.ResourceRate" /></label>
                    }
                </div>
            </section>

            @if (HasTreatmentCostControls)
            {
                <section class="moar-editor__section">
                    <div class="moar-editor__section-heading"><p class="moar-kicker">TREATMENT COSTS</p><h2>Set the resource consumed by each treatment</h2><p>These values are available only for conditions the selected base item can treat.</p></div>
                    <div class="moar-form-grid">
                        @if (SupportsLightBleedingTreatment) { <label>Stop light bleeding<input type="number" min="0" @bind="Draft.LightBleedingCost" /></label> }
                        @if (SupportsHeavyBleedingTreatment) { <label>Stop heavy bleeding<input type="number" min="0" @bind="Draft.HeavyBleedingCost" /></label> }
                        @if (SupportsRadiationTreatment) { <label>Stop radiation<input type="number" min="0" @bind="Draft.RadiationTreatmentCost" /></label> }
                    </div>
                </section>
            }

@if (IsSurgical)
            {
                <section class="moar-editor__section">
                    <div class="moar-editor__section-heading"><p class="moar-kicker">SURGICAL PROFILE</p><h2>Fine-tune surgical behavior</h2><p>Leave a multiplier blank to retain the selected vanilla kit's value.</p></div>
                    <div class="moar-form-grid">
                        <label>Use-time multiplier <span>0.5 = half the base time</span><input type="number" min="0.01" step="0.01" @bind="Draft.UseTimeMultiplier" placeholder="Base time" /></label>
                        <label>Limb-restoration multiplier <span>1.2 = 20% more health restored</span><input type="number" min="0.01" step="0.01" @bind="Draft.SurgeryRestoreMultiplier" placeholder="Base restoration" /></label>
                    </div>
                </section>
            }

            <section class="moar-editor__section">
                <div class="moar-editor__section-heading"><p class="moar-kicker">IDENTITY</p><h2>What players see</h2></div>
                <div class="moar-form-grid"><label>Definition ID<input @bind="Draft.Id" placeholder="e.g. field-afak" /></label><label class="moar-status-field"><span class="moar-status-field__label">@(Draft.Enabled ? "Enabled" : "Disabled")</span><span class="moar-status-toggle"><input type="checkbox" @bind="Draft.Enabled" /><span class="moar-status-toggle__control" aria-hidden="true"></span><span class="moar-status-toggle__description">Include this definition</span></span></label><label>Display name<input @bind="Draft.Identity.Name" /></label><label>Short name<input @bind="Draft.Identity.ShortName" /></label><label class="moar-description-field moar-form-grid__full">Description<textarea rows="4" @bind="Draft.Identity.Description"></textarea></label></div>
            </section>

            <section class="moar-editor__section"><div class="moar-editor__section-heading"><p class="moar-kicker">AVAILABILITY</p><h2>Set trader availability</h2><p>Every enabled item remains in world loot. This setting only controls whether it can be purchased from a trader.</p></div><div class="moar-form-grid"><label class="moar-status-field"><span class="moar-status-field__label">@(Draft.Trader!.Enabled ? "Enabled" : "Disabled")</span><span class="moar-status-toggle"><input type="checkbox" @bind="Draft.Trader!.Enabled" /><span class="moar-status-toggle__control" aria-hidden="true"></span><span class="moar-status-toggle__description">Make this medical pack purchasable</span></span></label>@if (Draft.Trader!.Enabled) { <label>Trader<select value="@SelectedTraderId" @onchange="SelectTrader">@foreach (AvailableTrader trader in AvailableTraders) { <option value="@trader.Id">@trader.DisplayName</option> }</select></label><label>Loyalty level<select @bind="Draft.Trader!.LoyaltyLevel">@foreach (int level in Enumerable.Range(1, 4)) { <option value="@level">Level @level</option> }</select></label><label>Price<input type="number" min="1" @bind="Draft.Trader!.Price" /></label> }</div></section>
        </form>

        <aside class="moar-editor-preview" aria-label="Medical-pack preview"><p class="moar-kicker">LIVE PREVIEW</p><h2>@Draft.Identity.Name</h2><span>@Draft.Identity.ShortName</span><p>@Draft.Identity.Description</p><dl><div><dt>Base item</dt><dd>@DisplayName(Draft.BaseItem)</dd></div><div><dt>@ResourceLabel</dt><dd>@Draft.Resource</dd></div>@if (IsMedicalKit) { <div><dt>Health per treatment</dt><dd>@Draft.ResourceRate</dd></div> } @if (IsSurgical) { <div><dt>Use time</dt><dd>@(Draft.UseTimeMultiplier is null ? "Base" : $"{Draft.UseTimeMultiplier:0.##}× base")</dd></div><div><dt>Limb restoration</dt><dd>@(Draft.SurgeryRestoreMultiplier is null ? "Base" : $"{Draft.SurgeryRestoreMultiplier:0.##}× base")</dd></div> }<div><dt>Availability</dt><dd>@(Draft.Trader?.Enabled == true ? TraderDisplayName(Draft.Trader) : "World loot only")</dd></div></dl><div class="moar-editor-preview__actions"><button type="button" class="moar-button" @onclick="SaveDraftAsync" disabled="@IsSaving">@(IsSaving ? "Saving…" : "Save medical pack")</button>@if (!IsCreating) { <div class="moar-delete-action"><button type="button" class="moar-delete-button" @onclick="OpenDeleteConfirmation">Delete Medical Pack</button></div> }</div><div class="moar-editor-preview__status">@if (SaveErrors.Count > 0) { <div class="moar-save-message moar-save-message--error" role="alert"><strong>Could not save</strong><ul>@foreach (string error in SaveErrors) { <li>@error</li> }</ul></div> } else if (!string.IsNullOrWhiteSpace(SaveMessage)) { <p class="moar-save-message moar-save-message--success" role="status">@SaveMessage</p> }</div></aside>
    </div>
}

@if (DeleteConfirmationOpen)
{
    <div class="moar-delete-dialog-backdrop" role="presentation" @onclick="CloseDeleteConfirmation"><section class="moar-delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="moar-delete-dialog-title" aria-describedby="moar-delete-dialog-description" @onclick:stopPropagation><p class="moar-kicker">DELETE MEDICAL PACK</p><h2 id="moar-delete-dialog-title">Delete @Draft?.Identity.Name?</h2><p id="moar-delete-dialog-description">This will completely remove the definition file from the database. It cannot be undone.</p>@if (DeleteErrors.Count > 0) { <div class="moar-save-message moar-save-message--error" role="alert"><strong>Could not delete</strong><ul>@foreach (string error in DeleteErrors) { <li>@error</li>}</ul></div> }<div class="moar-delete-dialog__actions"><button type="button" class="moar-button moar-button--secondary" @onclick="CloseDeleteConfirmation" disabled="@IsDeleting">Cancel</button><button type="button" class="moar-delete-button" @onclick="DeleteDraftAsync" disabled="@IsDeleting">@(IsDeleting ? "Deleting…" : "Proceed with deletion")</button></div></section></div>
}

@code {
    [Parameter] public string? MedicalPackId { get; set; }
    [Parameter] public bool CreateNew { get; set; }
    private MedicalPackDefinition? Draft;
    private bool IsCreating;
    private bool IsSaving;
    private bool IsDeleting;
    private bool DeleteConfirmationOpen;
    private string? SaveMessage;
    private List<string> SaveErrors = [];
    private List<string> DeleteErrors = [];
    private static readonly string[] BaseItems = ["afak", "ai2", "alu-splint", "analgin", "army-bandage", "augmentin", "bandage", "car", "cat", "calok-b", "cms", "esmarch", "golden-star", "grizzly", "ibuprofen", "ifak", "salewa", "sanitar-afak", "sanitar-surgery-kit", "splint", "surv12", "vaseline"];
    private sealed record MedicalPackDefaults(int Resource, int ResourceRate, int? LightBleedingCost = null, int? HeavyBleedingCost = null, int? RadiationTreatmentCost = null);
    private static readonly IReadOnlyDictionary<string, MedicalPackDefaults> BaseDefaults = new Dictionary<string, MedicalPackDefaults>(StringComparer.OrdinalIgnoreCase)
    {
        ["afak"] = new(400, 60, 30, 170, 0), ["ai2"] = new(100, 50, RadiationTreatmentCost: 0), ["alu-splint"] = new(5, 0), ["analgin"] = new(4, 0), ["army-bandage"] = new(2, 0), ["augmentin"] = new(0, 0), ["bandage"] = new(0, 0), ["car"] = new(220, 70, 50), ["cat"] = new(0, 0), ["calok-b"] = new(3, 0), ["cms"] = new(3, 0), ["esmarch"] = new(0, 0), ["golden-star"] = new(5, 0), ["grizzly"] = new(1800, 175, 40, 130, 0), ["ibuprofen"] = new(8, 0), ["ifak"] = new(300, 50, 30, 210, 0), ["salewa"] = new(400, 85, 45, 175), ["sanitar-afak"] = new(3000, 1), ["sanitar-surgery-kit"] = new(3000, 1), ["splint"] = new(0, 0), ["surv12"] = new(9, 0), ["vaseline"] = new(3, 0)
    };
    private static readonly HashSet<string> SurgicalBaseItems = new(StringComparer.OrdinalIgnoreCase) { "cms", "surv12", "sanitar-surgery-kit" };
    private static readonly HashSet<string> MedicalKitBaseItems = new(StringComparer.OrdinalIgnoreCase) { "afak", "ai2", "car", "grizzly", "ifak", "salewa", "sanitar-afak" };
    private IReadOnlyList<AvailableTrader> AvailableTraders => TraderDirectory.GetAvailableTraders();
    private string SelectedTraderId => Draft?.Trader is null ? string.Empty : ResolveSelectedTraderId(Draft.Trader);
    private bool IsSurgical => Draft is not null && SurgicalBaseItems.Contains(Draft.BaseItem);
    private bool IsMedicalKit => Draft is not null && MedicalKitBaseItems.Contains(Draft.BaseItem);
    private MedicalPackDefaults? SelectedBaseDefaults => Draft is not null && BaseDefaults.TryGetValue(Draft.BaseItem, out MedicalPackDefaults? defaults) ? defaults : null;
    private bool SupportsLightBleedingTreatment => SelectedBaseDefaults?.LightBleedingCost is not null;
    private bool SupportsHeavyBleedingTreatment => SelectedBaseDefaults?.HeavyBleedingCost is not null;
    private bool SupportsRadiationTreatment => SelectedBaseDefaults?.RadiationTreatmentCost is not null;
    private bool HasTreatmentCostControls => SupportsLightBleedingTreatment || SupportsHeavyBleedingTreatment || SupportsRadiationTreatment;
    private string ResourceLabel => IsSurgical ? "Surgery uses" : IsMedicalKit ? "Total HP pool" : "Uses / resource pool";

    protected override void OnParametersSet()
    {
        if (CreateNew && !IsCreating) { CreateDraft(); return; }
        if (string.IsNullOrWhiteSpace(MedicalPackId)) { if (!IsCreating) Draft = null; return; }
        MedicalPackDefinition? source = ConfigState.Current?.MedicalPacks.FirstOrDefault(medicalPack => string.Equals(medicalPack.Id, MedicalPackId, StringComparison.OrdinalIgnoreCase));
        Draft = source is null ? null : Copy(source); IsCreating = false; SaveMessage = null; SaveErrors = [];
    }

    private void CreateDraft() { MedicalPackDefaults defaults = BaseDefaults[BaseItems[0]]; Draft = new MedicalPackDefinition { Enabled = true, BaseItem = BaseItems[0], Resource = defaults.Resource, ResourceRate = defaults.ResourceRate, LightBleedingCost = defaults.LightBleedingCost, HeavyBleedingCost = defaults.HeavyBleedingCost, RadiationTreatmentCost = defaults.RadiationTreatmentCost, Trader = CreateDefaultTrader() }; IsCreating = true; SaveMessage = null; SaveErrors = []; }
    private void SelectBaseItem(ChangeEventArgs changeEvent) { if (Draft is null || changeEvent.Value is not string baseItem || !BaseDefaults.TryGetValue(baseItem, out MedicalPackDefaults? defaults)) return; Draft.BaseItem = baseItem; Draft.Resource = defaults.Resource; Draft.ResourceRate = defaults.ResourceRate; Draft.LightBleedingCost = defaults.LightBleedingCost; Draft.HeavyBleedingCost = defaults.HeavyBleedingCost; Draft.RadiationTreatmentCost = defaults.RadiationTreatmentCost; }
    private TraderDefinition CreateDefaultTrader() { AvailableTrader? trader = AvailableTraders.FirstOrDefault(candidate => string.Equals(candidate.Id, "54cb57776803fa99248b456e", StringComparison.OrdinalIgnoreCase)) ?? AvailableTraders.FirstOrDefault(); return trader is null ? new TraderDefinition { LoyaltyLevel = 1 } : new TraderDefinition { Trader = trader.ConfigurationName, TraderId = trader.Id, LoyaltyLevel = 1 }; }
    private string ResolveSelectedTraderId(TraderDefinition trader) => !string.IsNullOrWhiteSpace(trader.TraderId) ? trader.TraderId : TraderDirectory.TryResolve(trader, out string traderId) ? traderId : string.Empty;
    private static string TraderDisplayName(TraderDefinition trader) => string.Equals(trader.TraderId, "579dc571d53a0658a154fbec", StringComparison.OrdinalIgnoreCase) ? "Fence *" : trader.Trader;
    private void SelectTrader(ChangeEventArgs changeEvent) { if (Draft?.Trader is null || changeEvent.Value is not string traderId) return; AvailableTrader? trader = AvailableTraders.FirstOrDefault(candidate => string.Equals(candidate.Id, traderId, StringComparison.OrdinalIgnoreCase)); if (trader is not null) { Draft.Trader.Trader = trader.ConfigurationName; Draft.Trader.TraderId = trader.Id; } }
    private void OpenDeleteConfirmation() { DeleteErrors = []; DeleteConfirmationOpen = true; }
    private void CloseDeleteConfirmation() { if (!IsDeleting) { DeleteConfirmationOpen = false; DeleteErrors = []; } }
    private async Task DeleteDraftAsync() { if (Draft is null || string.IsNullOrWhiteSpace(MedicalPackId) || IsCreating || IsDeleting) return; IsDeleting = true; DeleteErrors = []; ConfigSaveResult result = await ConfigStorage.DeleteMedicalPackAsync(MedicalPackId, CancellationToken.None); IsDeleting = false; DeleteErrors = result.Errors.ToList(); if (result.Succeeded) { DeleteConfirmationOpen = false; NavigationManager.NavigateTo("/moar-supplies/database"); } }
    private async Task SaveDraftAsync() { if (Draft is null || IsSaving) return; IsSaving = true; SaveMessage = null; SaveErrors = []; ConfigSaveResult result = await ConfigStorage.SaveMedicalPackAsync(Draft, IsCreating ? null : MedicalPackId, CancellationToken.None); IsSaving = false; SaveErrors = result.Errors.ToList(); if (result.Succeeded) { IsCreating = false; MedicalPackId = Draft.Id; SaveMessage = "Saved to config/medical-packs. Restart the SPT server to apply this definition in-game."; } }
    private static string DisplayName(string value) => System.Text.RegularExpressions.Regex.Replace(value.Replace('-', ' '), "(?<!^)([A-Z])", " $1");
    private static MedicalPackDefinition Copy(MedicalPackDefinition source) => new() { Id = source.Id, Enabled = source.Enabled, BaseItem = source.BaseItem, Resource = source.Resource, ResourceRate = source.ResourceRate, LightBleedingCost = source.LightBleedingCost, HeavyBleedingCost = source.HeavyBleedingCost, RadiationTreatmentCost = source.RadiationTreatmentCost, UseTimeMultiplier = source.UseTimeMultiplier, SurgeryRestoreMultiplier = source.SurgeryRestoreMultiplier, Tags = [.. source.Tags], Identity = new StimIdentity { Name = source.Identity.Name, ShortName = source.Identity.ShortName, Description = source.Identity.Description }, Trader = source.Trader is null ? new TraderDefinition() : new TraderDefinition { Enabled = source.Trader.Enabled, Trader = source.Trader.Trader, TraderId = source.Trader.TraderId, LoyaltyLevel = source.Trader.LoyaltyLevel, Price = source.Trader.Price } };
}
