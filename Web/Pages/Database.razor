@page "/moar-supplies/database"
@attribute [Authorize(Policy = "Administrator")]
@layout BaseMudBlazorLayout
@inject ConfigState ConfigState

<PageTitle>Supply Database - Moar Supplies</PageTitle>

<MoarSuppliesLayout>
    <main class="moar-home">
        <section class="moar-home-shell moar-database-shell">
            <MoarNavigation CurrentPage="Database" />

            <section class="moar-database" aria-labelledby="moar-database-title">
                <div class="moar-database__heading">
                    <div>
                        <p class="moar-kicker">CURRENT CONFIGURATION</p>
                        <h1 id="moar-database-title">Supply database</h1>
                        <p>Browse configured supplies. Open an entry to inspect its effects, resource, and trader availability. Every enabled item remains in world loot; trader availability only controls purchasing.</p>
                    </div>
                    @if (Config is not null)
                    {
                        <span class="moar-database__count">@(Config.Stims.Count + Config.Drinks.Count + Config.MedicalPacks.Count) definition@(Config.Stims.Count + Config.Drinks.Count + Config.MedicalPacks.Count == 1 ? string.Empty : "s")</span>
                    }
                </div>

                @if (Config is null)
                {
                    <div class="moar-database__empty">
                        <strong>Configuration unavailable</strong>
                        <p>The database will populate after SPT loads a valid <code>config/stims.json</code>.</p>
                    </div>
                }
                else if (Config.Stims.Count == 0 && Config.Drinks.Count == 0 && Config.MedicalPacks.Count == 0)
                {
                    <div class="moar-database__empty">
                        <strong>No supplies are configured</strong>
                        <p>Create your first Moar Supplies stimulant, drink, or medical pack from the Modify workspace.</p>
                    </div>
                }
                else
                {
                    <div class="moar-database__groups">
                        @if (Config.MedicalPacks.Count > 0)
                        {
                        <section class="moar-database__group">
                            <header class="moar-database__group-heading"><p class="moar-kicker">MEDICAL PACKS</p><h2>Configured medical packs</h2></header>
                            <ol class="moar-database-list">
                                @foreach (MedicalPackDefinition medicalPack in Config.MedicalPacks.OrderBy(medicalPack => medicalPack.Identity.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    <li><details class="moar-stim-entry"><summary><span class="moar-stim-entry__identity"><strong>@medicalPack.Identity.Name</strong><small>@medicalPack.Identity.ShortName</small></span><span class="moar-stim-entry__tags">@foreach (string tag in medicalPack.Tags) { <small>@tag</small> }</span><span class="moar-stim-entry__description">@medicalPack.Identity.Description</span><span class="moar-stim-entry__actions"><span class="moar-stim-entry__toggle" aria-hidden="true">View details</span><a class="moar-button moar-button--secondary" href="@($"/moar-supplies/modify?medicalPack={Uri.EscapeDataString(medicalPack.Id)}")" @onclick:stopPropagation>Edit definition</a></span></summary><div class="moar-stim-entry__details"><p class="moar-stim-entry__profile-kicker moar-kicker">MEDICAL PROFILE</p><div class="moar-stim-entry__facts"><span><small>Base item</small><strong>@medicalPack.BaseItem</strong></span><span><small>Uses / pool</small><strong>@medicalPack.Resource</strong></span>@if (medicalPack.BaseItem is "cms" or "surv12") { <span><small>Use time</small><strong>@(medicalPack.UseTimeMultiplier is null ? "Base" : $"{medicalPack.UseTimeMultiplier:0.##}×")</strong></span><span><small>Limb restoration</small><strong>@(medicalPack.SurgeryRestoreMultiplier is null ? "Base" : $"{medicalPack.SurgeryRestoreMultiplier:0.##}×")</strong></span> } else { <span><small>Health per treatment</small><strong>@medicalPack.ResourceRate</strong></span> }<span><small>Availability</small><strong>@TraderLabel(medicalPack.Trader)</strong></span><span><small>Status</small><strong class="@(medicalPack.Enabled ? "moar-status-active" : "moar-status-disabled")">@(medicalPack.Enabled ? "Active" : "Disabled")</strong></span></div></div></details></li>
                                }
                            </ol>
                        </section>
                        }
                        @if (Config.Drinks.Count > 0)
                        {
                        <section class="moar-database__group">
                            <header class="moar-database__group-heading"><p class="moar-kicker">DRINKS</p><h2>Configured drinks</h2></header>
                            <ol class="moar-database-list">
                                @foreach (DrinkDefinition drink in Config.Drinks.OrderBy(drink => drink.Identity.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    <li><details class="moar-stim-entry"><summary><span class="moar-stim-entry__identity"><strong>@drink.Identity.Name</strong><small>@drink.Identity.ShortName</small></span><span class="moar-stim-entry__tags">@foreach (string tag in drink.Tags) { <small>@tag</small> }</span><span class="moar-stim-entry__description">@drink.Identity.Description</span><span class="moar-stim-entry__actions"><span class="moar-stim-entry__toggle" aria-hidden="true">View details</span><a class="moar-button moar-button--secondary" href="@($"/moar-supplies/modify?drink={Uri.EscapeDataString(drink.Id)}")" @onclick:stopPropagation>Edit definition</a></span></summary><div class="moar-stim-entry__details"><p class="moar-stim-entry__profile-kicker moar-kicker">DRINK PROFILE · @drink.Buffs.Count TIMED EFFECT@(drink.Buffs.Count == 1 ? string.Empty : "S")</p><div class="moar-stim-entry__facts"><span><small>Base drink</small><strong>@drink.BaseItem</strong></span><span><small>Resource</small><strong>@drink.Resource</strong></span><span><small>Hydration</small><strong>@drink.Nutrition.Hydration</strong></span><span><small>Energy</small><strong>@drink.Nutrition.Energy</strong></span><span><small>Availability</small><strong>@TraderLabel(drink.Trader)</strong></span></div></div></details></li>
                                }
                            </ol>
                        </section>
                        }
                        @if (Config.Stims.Count > 0)
                        {
                        <section class="moar-database__group">
                            <header class="moar-database__group-heading"><p class="moar-kicker">STIMS</p><h2>Configured stims</h2></header>
                            <ol class="moar-database-list">
                        @foreach (StimDefinition stim in Config.Stims.OrderBy(stim => stim.Identity.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            List<BuffDefinition> buffs = stim.Buffs.Where(buff => !IsDebuff(buff)).ToList();
                            List<BuffDefinition> debuffs = stim.Buffs.Where(IsDebuff).ToList();
                            <li>
                                <details class="moar-stim-entry">
                                    <summary>
                                        <span class="moar-stim-entry__identity">
                                            <strong>@stim.Identity.Name</strong>
                                            <small>@stim.Identity.ShortName</small>
                                        </span>
                                        <span class="moar-stim-entry__tags" aria-label="Stim tags">
                                            @foreach (string tag in stim.Tags)
                                            {
                                                <small>@tag</small>
                                            }
                                        </span>
                                        <span class="moar-stim-entry__description">@stim.Identity.Description</span>
                                        <span class="moar-stim-entry__actions">
                                            <span class="moar-stim-entry__toggle" aria-hidden="true">View details</span>
                                            <a class="moar-button moar-button--secondary" href="@($"/moar-supplies/modify?stim={Uri.EscapeDataString(stim.Id)}")" @onclick:stopPropagation>Edit definition</a>
                                        </span>
                                    </summary>

                                    <div class="moar-stim-entry__details">
                                        <p class="moar-stim-entry__profile-kicker moar-kicker">EFFECT PROFILE · @stim.Buffs.Count EFFECT@(stim.Buffs.Count == 1 ? string.Empty : "S")</p>
                                        <div class="moar-stim-entry__facts">
                                            <span><small>Base item</small><strong>@stim.BaseItem</strong></span>
                                            <span><small>Uses</small><strong>@stim.Uses</strong></span>
                                            <span><small>Availability</small><strong>@TraderLabel(stim.Trader)</strong></span>
                                            <span><small>Status</small><strong class="@(stim.Enabled ? "moar-status-active" : "moar-status-disabled")">@(stim.Enabled ? "Active" : "Disabled")</strong></span>
                                        </div>
                                        <div class="moar-stim-entry__effects">
                                            @if (buffs.Count > 0)
                                            {
                                                <section class="moar-effect-group moar-effect-group--buffs">
                                                    <p>Buffs · @buffs.Count</p>
                                                    <ul>
                                                        @foreach (BuffDefinition buff in buffs)
                                                        {
                                                            <li><strong>@DisplayEffectName(buff.Effect)</strong><span>@DisplayEffectDetails(buff)</span></li>
                                                        }
                                                    </ul>
                                                </section>
                                            }
                                            @if (debuffs.Count > 0)
                                            {
                                                <section class="moar-effect-group moar-effect-group--debuffs">
                                                    <p>Debuffs · @debuffs.Count</p>
                                                    <ul>
                                                        @foreach (BuffDefinition buff in debuffs)
                                                        {
                                                            <li><strong>@DisplayEffectName(buff.Effect)</strong><span>@DisplayEffectDetails(buff)</span></li>
                                                        }
                                                    </ul>
                                                </section>
                                            }
                                            @if (stim.Buffs.Count == 0)
                                            {
                                                <p class="moar-no-effects">No effects configured.</p>
                                            }
                                        </div>
                                    </div>
                                </details>
                            </li>
                        }
                            </ol>
                        </section>
                        }
                    </div>
                }
            </section>
        </section>
    </main>
</MoarSuppliesLayout>

@code {
    private ModConfig? Config => ConfigState.Current;

    private static string TraderLabel(TraderDefinition? trader) => trader is { Enabled: true }
        ? $"{trader.Trader} · LL{trader.LoyaltyLevel} · {trader.Price:N0} ₽"
        : "World loot only";

    private static string DisplayEffectName(string effect) => string.IsNullOrWhiteSpace(effect)
        ? "Unknown effect"
        : System.Text.RegularExpressions.Regex.Replace(effect, "(?<!^)([A-Z])", " $1");

    private static bool IsDebuff(BuffDefinition buff) => BuffMappings.IsDebuff(buff.Effect, buff.Value);

    private static string DisplayEffectDetails(BuffDefinition buff)
    {
        string value = buff.Value is null ? "Status effect" : $"{buff.Value.Value:+0.##;-0.##;0}";
        string delay = buff.Delay > 0 ? $" · +{buff.Delay}s delay" : string.Empty;
        return $"{value} · {buff.Duration}s{delay}";
    }
}
