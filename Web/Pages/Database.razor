@page "/moar-supplies/database"
@attribute [Authorize(Policy = "Administrator")]
@layout BaseMudBlazorLayout
@inject ConfigState ConfigState

<PageTitle>Stimulant Database - Moar Supplies</PageTitle>

<MoarSuppliesLayout>
    <main class="moar-home">
        <section class="moar-home-shell moar-database-shell">
            <MoarNavigation CurrentPage="Database" />

            <section class="moar-database" aria-labelledby="moar-database-title">
                <div class="moar-database__heading">
                    <div>
                        <p class="moar-kicker">CURRENT CONFIGURATION</p>
                        <h1 id="moar-database-title">Stimulant database</h1>
                        <p>Browse every configured stim. Open an entry to inspect its effects, uses, and optional trader availability.</p>
                    </div>
                    @if (Config is not null)
                    {
                        <span class="moar-database__count">@Config.Stims.Count definition@(Config.Stims.Count == 1 ? string.Empty : "s")</span>
                    }
                </div>

                @if (Config is null)
                {
                    <div class="moar-database__empty">
                        <strong>Configuration unavailable</strong>
                        <p>The database will populate after SPT loads a valid <code>config/stims.json</code>.</p>
                    </div>
                }
                else if (Config.Stims.Count == 0)
                {
                    <div class="moar-database__empty">
                        <strong>No stims are configured</strong>
                        <p>Create your first custom stimulant from the Modify workspace once it is available.</p>
                    </div>
                }
                else
                {
                    <ol class="moar-database-list">
                        @foreach (StimDefinition stim in Config.Stims.OrderBy(stim => stim.Identity.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            List<BuffDefinition> buffs = stim.Buffs.Where(buff => !IsDebuff(buff)).ToList();
                            List<BuffDefinition> debuffs = stim.Buffs.Where(IsDebuff).ToList();
                            <li>
                                <details class="moar-stim-entry">
                                    <summary>
                                        <span class="moar-stim-entry__identity">
                                            <strong>@stim.Identity.Name</strong>
                                            <small>@stim.Identity.ShortName</small>
                                        </span>
                                        <span class="moar-stim-entry__tags" aria-label="Stim tags">
                                            @foreach (string tag in stim.Tags)
                                            {
                                                <small>@tag</small>
                                            }
                                        </span>
                                        <span class="moar-stim-entry__description">@stim.Identity.Description</span>
                                        <span class="moar-stim-entry__actions">
                                            <span class="moar-stim-entry__toggle" aria-hidden="true">View details</span>
                                            <a class="moar-button moar-button--secondary" href="@($"/moar-supplies/modify?stim={Uri.EscapeDataString(stim.Id)}")" @onclick:stopPropagation>Edit definition</a>
                                        </span>
                                    </summary>

                                    <div class="moar-stim-entry__details">
                                        <p class="moar-stim-entry__profile-kicker moar-kicker">EFFECT PROFILE · @stim.Buffs.Count EFFECT@(stim.Buffs.Count == 1 ? string.Empty : "S")</p>
                                        <div class="moar-stim-entry__facts">
                                            <span><small>Base item</small><strong>@stim.BaseItem</strong></span>
                                            <span><small>Uses</small><strong>@stim.Uses</strong></span>
                                            <span><small>Availability</small><strong>@TraderLabel(stim.Trader)</strong></span>
                                            <span><small>Status</small><strong class="@(stim.Enabled ? "moar-status-active" : "moar-status-disabled")">@(stim.Enabled ? "Active" : "Disabled")</strong></span>
                                        </div>
                                        <div class="moar-stim-entry__effects">
                                            @if (buffs.Count > 0)
                                            {
                                                <section class="moar-effect-group moar-effect-group--buffs">
                                                    <p>Buffs · @buffs.Count</p>
                                                    <ul>
                                                        @foreach (BuffDefinition buff in buffs)
                                                        {
                                                            <li><strong>@DisplayEffectName(buff.Effect)</strong><span>@DisplayEffectDetails(buff)</span></li>
                                                        }
                                                    </ul>
                                                </section>
                                            }
                                            @if (debuffs.Count > 0)
                                            {
                                                <section class="moar-effect-group moar-effect-group--debuffs">
                                                    <p>Debuffs · @debuffs.Count</p>
                                                    <ul>
                                                        @foreach (BuffDefinition buff in debuffs)
                                                        {
                                                            <li><strong>@DisplayEffectName(buff.Effect)</strong><span>@DisplayEffectDetails(buff)</span></li>
                                                        }
                                                    </ul>
                                                </section>
                                            }
                                            @if (stim.Buffs.Count == 0)
                                            {
                                                <p class="moar-no-effects">No effects configured.</p>
                                            }
                                        </div>
                                    </div>
                                </details>
                            </li>
                        }
                    </ol>
                }
            </section>
        </section>
    </main>
</MoarSuppliesLayout>

@code {
    private ModConfig? Config => ConfigState.Current;

    private static string TraderLabel(TraderDefinition? trader) => trader is { Enabled: true }
        ? $"{trader.Trader} · LL{trader.LoyaltyLevel} · {trader.Price:N0} ₽"
        : "Not sold";

    private static string DisplayEffectName(string effect) => string.IsNullOrWhiteSpace(effect)
        ? "Unknown effect"
        : System.Text.RegularExpressions.Regex.Replace(effect, "(?<!^)([A-Z])", " $1");

    private static bool IsDebuff(BuffDefinition buff) => BuffMappings.IsDebuff(buff.Effect, buff.Value);

    private static string DisplayEffectDetails(BuffDefinition buff)
    {
        string value = buff.Value is null ? "Status effect" : $"{buff.Value.Value:+0.##;-0.##;0}";
        string delay = buff.Delay > 0 ? $" · +{buff.Delay}s delay" : string.Empty;
        return $"{value} · {buff.Duration}s{delay}";
    }
}
