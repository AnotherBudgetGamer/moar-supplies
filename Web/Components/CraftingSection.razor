@using MoarSupplies.Models
@inject ItemCatalogService ItemCatalog

<section class="moar-editor__section">
    <div class="moar-editor__section-heading">
        <p class="moar-kicker">CRAFTING</p>
        <h2>Configure hideout crafting</h2>
        <p>Set where this item is crafted, then search the installed SPT item catalog for ingredients.</p>
    </div>
    <div class="moar-form-grid">
        <label class="moar-status-field">
            <span class="moar-status-field__label">@(Craft?.Enabled == true ? "Enabled" : "Disabled")</span>
            <span class="moar-status-toggle">
                <input type="checkbox" checked="@(Craft?.Enabled == true)" @onchange="ToggleCraftAsync" />
                <span class="moar-status-toggle__control" aria-hidden="true"></span>
                <span class="moar-status-toggle__description">Make this @ItemLabel craftable</span>
            </span>
        </label>
        @if (Craft is { Enabled: true } craft)
        {
            <label>Bench<select @bind="craft.Bench">@foreach ((string value, string name) in Benches) { <option value="@value">@name</option> }</select></label>
            <label>Bench level<select @bind="craft.BenchLevel">@foreach (int level in Enumerable.Range(1, 3)) { <option value="@level">Level @level</option> }</select></label>
            <label>Timer <span>seconds</span><input type="number" min="1" @bind="craft.DurationSeconds" /></label>
            <label>Output count<input type="number" min="1" @bind="craft.OutputCount" /></label>
            <label class="moar-status-field">
                <span class="moar-status-field__label">@(craft.RequiresFuel ? "Fuel required" : "No fuel")</span>
                <span class="moar-status-toggle">
                    <input type="checkbox" @bind="craft.RequiresFuel" />
                    <span class="moar-status-toggle__control" aria-hidden="true"></span>
                    <span class="moar-status-toggle__description">Require fuel for the full craft</span>
                </span>
            </label>
            <div class="moar-crafting-ingredients moar-form-grid__full">
                <label>Find ingredient<input value="@IngredientSearch" @oninput="SearchIngredients" @onfocus="OpenIngredientSearch" @onblur="CloseIngredientSearchAsync" placeholder="Search by item name, short name, or template ID" autocomplete="off" /></label>
                @if (IsIngredientSearchOpen && IngredientResults.Count > 0)
                {
                    <div class="moar-crafting-ingredients__results" role="listbox" aria-label="Ingredient search results">
                        @foreach (CraftIngredientOption option in IngredientResults)
                        {
                            <button type="button" role="option" aria-selected="@(string.Equals(SelectedTemplateId, option.TemplateId, StringComparison.OrdinalIgnoreCase))" @onclick="() => SelectIngredient(option)">@option.DisplayName</button>
                        }
                    </div>
                }
                <div class="moar-crafting-ingredients__add-row">
                    <label>Count<input type="number" min="1" @bind="IngredientCount" /></label>
                    <button type="button" class="moar-button moar-crafting-ingredients__add-button" @onclick="AddIngredient" disabled="@(!CanAddIngredient)">Add ingredient</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(SelectedTemplateId) && !CanAddIngredient && craft.Ingredients.Any(ingredient => string.Equals(ingredient.TemplateId, SelectedTemplateId, StringComparison.OrdinalIgnoreCase)))
                {
                    <p class="moar-crafting-ingredients__hint">This ingredient is already listed below. Adjust its count there.</p>
                }
                @if (craft.Ingredients.Count > 0)
                {
                    <div class="moar-crafting-ingredients__selected" aria-label="Selected ingredients">
                        @foreach (CraftIngredientDefinition ingredient in craft.Ingredients)
                        {
                            <div class="moar-crafting-ingredient" @key="ingredient">
                                <span>@ItemCatalog.GetDisplayName(ingredient.TemplateId)</span>
                                <label>Count<input type="number" min="1" @bind="ingredient.Count" /></label>
                                <button type="button" class="moar-icon-button" title="Remove ingredient" @onclick="() => RemoveIngredient(craft, ingredient)">×</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public CraftDefinition? Craft { get; set; }
    [Parameter] public EventCallback<CraftDefinition?> CraftChanged { get; set; }
    [Parameter] public string ItemLabel { get; set; } = "item";
    private string IngredientSearch { get; set; } = string.Empty;
    private string? SelectedTemplateId { get; set; }
    private int IngredientCount { get; set; } = 1;
    private bool IsIngredientSearchOpen { get; set; }
    private int IngredientSearchFocusVersion { get; set; }

    private IReadOnlyList<CraftIngredientOption> IngredientResults => ItemCatalog.Search(IngredientSearch);
    private bool CanAddIngredient => Craft is { Enabled: true } craft
        && !string.IsNullOrWhiteSpace(SelectedTemplateId)
        && IngredientCount > 0
        && craft.Ingredients.All(ingredient => !string.Equals(ingredient.TemplateId, SelectedTemplateId, StringComparison.OrdinalIgnoreCase));

    private static readonly (string Value, string Name)[] Benches =
    [
        ("medStation", "Med Station"),
        ("kitchen", "Kitchen"),
        ("heating", "Heating"),
        ("waterCollector", "Water Collector"),
        ("workbench", "Workbench"),
        ("intelligenceCenter", "Intelligence Center")
    ];

    private async Task ToggleCraftAsync(ChangeEventArgs changeEvent)
    {
        CraftDefinition craft = Craft ?? new CraftDefinition();
        craft.Enabled = changeEvent.Value is bool enabled && enabled;
        await CraftChanged.InvokeAsync(craft);
    }

    private void SearchIngredients(ChangeEventArgs changeEvent)
    {
        IngredientSearch = changeEvent.Value?.ToString() ?? string.Empty;
        SelectedTemplateId = null;
        IsIngredientSearchOpen = true;
    }

    private void OpenIngredientSearch()
    {
        IngredientSearchFocusVersion++;
        IsIngredientSearchOpen = true;
    }

    private async Task CloseIngredientSearchAsync()
    {
        int focusVersion = IngredientSearchFocusVersion;
        await Task.Delay(150);

        if (focusVersion == IngredientSearchFocusVersion)
        {
            IsIngredientSearchOpen = false;
        }
    }

    private void SelectIngredient(CraftIngredientOption option)
    {
        SelectedTemplateId = option.TemplateId;
        IngredientSearch = option.DisplayName;
        IngredientCount = 1;
    }

    private void AddIngredient()
    {
        if (!CanAddIngredient || Craft is null || SelectedTemplateId is null) return;
        Craft.Ingredients.Add(new CraftIngredientDefinition { TemplateId = SelectedTemplateId, Count = IngredientCount });
        IngredientSearch = string.Empty;
        SelectedTemplateId = null;
        IngredientCount = 1;
    }

    private static void RemoveIngredient(CraftDefinition craft, CraftIngredientDefinition ingredient) => craft.Ingredients.Remove(ingredient);
}
