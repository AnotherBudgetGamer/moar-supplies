<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>MoarSupplies</AssemblyName>
    <RootNamespace>MoarSupplies</RootNamespace>
    <ModAuthor>AnotherBudgetGamer</ModAuthor>
    <Version>0.5.1</Version>
    <OutputPath>bin\$(Configuration)\$(ModAuthor)-$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SptRuntimeDirectory Condition="'$(SptRuntimeDirectory)' == ''">$(MSBuildThisFileDirectory)..\spt-read-only\SPP-Tarkov\SPT_Runtime\</SptRuntimeDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptRuntimeDirectory)SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptRuntimeDirectory)SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptRuntimeDirectory)SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Web">
      <HintPath>$(SptRuntimeDirectory)SPTarkov.Server.Web.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="config\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleaseDirectory>$(MSBuildProjectDirectory)\ReleaseZip\</ReleaseDirectory>
      <ZipOutput>$(ReleaseDirectory)$(ModAuthor)-$(AssemblyName)-$(Version).zip</ZipOutput>
      <ZipTempDirectory>$(IntermediateOutputPath)ReleaseZip\</ZipTempDirectory>
      <ModDirectoryName>$(ModAuthor)-$(AssemblyName)</ModDirectoryName>
    </PropertyGroup>

    <MakeDir Directories="$(ReleaseDirectory)" />
    <RemoveDir Directories="$(ZipTempDirectory)" />
    <MakeDir Directories="$(ZipTempDirectory)SPT_Runtime\user\mods\$(ModDirectoryName)" />

    <ItemGroup>
      <ReleaseFiles Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReleaseFiles)"
          DestinationFiles="@(ReleaseFiles->'$(ZipTempDirectory)SPT_Runtime\user\mods\$(ModDirectoryName)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(ZipTempDirectory)" DestinationFile="$(ZipOutput)" Overwrite="true" />
    <Message Importance="High" Text="Created release archive: $(ZipOutput)" />
  </Target>
</Project>